<?xml version='1.0'?>
<VOTABLE version="1.4" xmlns="http://www.ivoa.net/xml/VOTable/v1.4"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.4 http://www.ivoa.net/xml/VOTable/VOTable-1.4.xsd">
    <RESOURCE type="meta" utype="adhoc:service">
        <DESCRIPTION>Simple LVF-cutout service</DESCRIPTION>
        <PARAM name="standardID" datatype="char" arraysize="*" value="remove-or-custom-id" />
        <PARAM arraysize="*" datatype="char" name="accessURL" value="https://irsadev.ipac.caltech.edu/spherex/lvf-cutout" />
        <GROUP name="inputParams">
            <PARAM datatype="double" name="RA" ref="ra" ucd="pos.eq.ra;meta.main">
                <DESCRIPTION>center RA (J2000)</DESCRIPTION>
            </PARAM>
            <PARAM datatype="double" name="DEC" ref="dec" ucd="pos.eq.dec;meta.main">
                <DESCRIPTION>center RA (J2000)</DESCRIPTION>
            </PARAM>
            <PARAM datatype="double" name="size" unit="deg" ucd="phys.size" value="0.01">
                <DESCRIPTION>Cutout size in degrees</DESCRIPTION>
                <VALUES>
                    <MIN value="0"/>
                    <MAX value="6.25"/>
                </VALUES>
            </PARAM>
            <PARAM name="file" datatype="long" arraysize="*">
                <DESCRIPTION>ID of LVF-image</DESCRIPTION>
            </PARAM>
        </GROUP>
    </RESOURCE>
    <!--  utype="ipac:MultiSpectrum" To indicate document contains multiple spectrums    -->
    <RESOURCE type="results" utype="ipac:MultiSpectrum">
        <TABLE utype="ipac:MultiSpectrum">

            <!--  To indicate the data is packed in an array    -->
            <GROUP ID="photometry" utype="ipac:Spectrum.ArrayData">
                <GROUP utype="spec:Spectrum.Data.SpectralAxis">
                    <FIELDref ref="lambda"/>
                    <GROUP utype="spec:Spectrum.Data.SpectralAxis.Accuracy">
                        <FIELDref ref="lambda_width"/>
                    </GROUP>
                </GROUP>
                <GROUP utype="spec:Spectrum.Data.FluxAxis">
                    <FIELDref ref="flux"/>
                    <GROUP utype="spec:Spectrum.Data.FluxAxis.Accuracy">
                        <FIELDref ref="flux_err"/>
                    </GROUP>
                </GROUP>
                <!-- additional related columns -->
                <FIELDref ref="ra" />
                <FIELDref ref="dec" />
                <FIELDref ref="x_image" />
                <FIELDref ref="y_image" />
                <FIELDref ref="offset_ra" />
                <FIELDref ref="offset_dec" />
                <FIELDref ref="mjd" />
                <FIELDref ref="flux_bkg" />
                <FIELDref ref="flags" />
                <FIELDref ref="fit_ql" />
                <FIELDref ref="deep_flg" />
                <FIELDref ref="lvf_id" />
                <FIELDref ref="det_id" />
            </GROUP>
            <GROUP ID="interp"  utype="ipac:Spectrum.ArrayData">
                <GROUP utype="spec:Spectrum.Data.SpectralAxis">
                    <PARAMref ref="lambda_interp"/>
                </GROUP>
                <GROUP utype="spec:Spectrum.Data.FluxAxis">
                    <FIELDref ref="flux_interp"/>
                    <GROUP utype="spec:Spectrum.Data.FluxAxis.Accuracy">
                        <FIELDref ref="flux_interp_err"/>
                    </GROUP>
                </GROUP>
            </GROUP>

            <FIELD ID="source_id" datatype="long" name="source_id" ucd="meta.id"/>
            <FIELD ID="external_survey" datatype="unsignedByte" name="external_survey"/>
            <FIELD ID="external_source_id" datatype="long" name="external_source_id" ucd="meta.id"/>
            <FIELD ID="spherex_class" datatype="int" name="spherex_class"/>
            <FIELD ID="ra" datatype="double" name="ra" precision="7" ucd="pos.eq.ra;meta.main" unit="deg" width="11"/>
            <FIELD ID="dec" datatype="double" name="dec" precision="7" ucd="pos.eq.dec;meta.main" unit="deg" width="11"/>
            <FIELD ID="pm_ra" datatype="float" name="pm_ra" unit="mas/yr"/>
            <FIELD ID="pm_dec" datatype="float" name="pm_dec" unit="mas/yr"/>
            <FIELD ID="parallax" datatype="float" name="parallax" unit="mas"/>
            <FIELD ID="x_image" arraysize="*" datatype="float" name="x_image" unit="pix"/>
            <FIELD ID="y_image" arraysize="*" datatype="float" name="y_image" unit="pix"/>
            <FIELD ID="offset_ra" arraysize="*" datatype="float" name="offset_ra" unit="mas"/>
            <FIELD ID="offset_dec" arraysize="*" datatype="float" name="offset_dec" unit="mas"/>
            <FIELD ID="mjd" arraysize="*" datatype="double" name="mjd" unit="d"/>
            <FIELD ID="lambda" arraysize="*" datatype="float" name="lambda" ucd="em.wavenumber" unit="um" utype="spec:Spectrum.Data.SpectralAxis.Value"/>
            <FIELD ID="lambda_width" arraysize="*" datatype="float" name="lambda_width" unit="um" utype="spec:Spectrum.Data.SpectralAxis.Accuracy.BinSize" />
            <FIELD ID="flux" arraysize="*" datatype="float" name="flux" unit="uJy" utype="spec:Spectrum.Data.FluxAxis.Value"/>
            <FIELD ID="flux_err" arraysize="*" datatype="float" name="flux_err" unit="uJy" utype="spec:Spectrum.Data.FluxAxis.Accuracy.StatError"/>
            <FIELD ID="flux_bkg" arraysize="*" datatype="float" name="flux_bkg" unit="MJy/sr" />
            <FIELD ID="flux_interp" arraysize="102" datatype="float" name="flux_interp" unit="uJy" utype="spec:Spectrum.Data.FluxAxis.Value"/>
            <FIELD ID="flux_interp_err" arraysize="102" datatype="float" name="flux_interp_err" unit="uJy" utype="spec:Spectrum.Data.FluxAxis.Accuracy.StatError"/>
            <FIELD ID="ext_flg" datatype="bit" name="ext_flg"/>
            <FIELD ID="flags" arraysize="*" datatype="long" name="flags" utype="spec:Spectrum.Data.FluxAxis.Quality"/>
            <FIELD ID="fit_ql" arraysize="*" datatype="float" name="fit_ql"/>
            <FIELD ID="deep_flg" arraysize="*" datatype="bit" name="deep_flg"/>
            <FIELD ID="lvf_id" arraysize="*" datatype="long" name="lvf_id"/>
            <FIELD ID="det_id" arraysize="*" datatype="unsignedByte" name="det_id"/>
            <FIELD ID="nyquist_comp" datatype="float" name="nyquist_comp"/>
            <PARAM ID="lambda_interp"
                   name="lambda_interp"
                   datatype="float"
                   arraysize="102"
                   ucd="em.wavenumber"
